{
  "name": "property-fee-dunning-service",
  "version": "1.0.0",
  "description": "物业费催缴后端服务 - 提供欠费查询、费用重算、催缴任务、模板选择、发送队列、回执登记、付款同步、减免申请等能力",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:memory": "node src/scripts/startWithMongo.js both",
    "dev": "nodemon src/app.js",
    "init": "node src/scripts/startWithMongo.js init",
    "init:remote": "node src/scripts/initData.js",
    "verify": "node src/scripts/verifyApis.js",
    "e2e": "node src/scripts/e2eTest.js",
    "lint": "eslint src/**/*.js",
    "test": "node src/scripts/e2eTest.js",
    "check": "node -e \"require('./src/app.js')\" 2>&1 || echo '语法检查完成'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "json2csv": "^6.0.0-alpha.2",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "property",
    "fee",
    "dunning",
    "backend"
  ],
  "author": "",
  "license": "MIT"
}
