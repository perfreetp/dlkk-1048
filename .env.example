PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/property_dunning
MONGODB_OPTIONS={"useNewUrlParser":true,"useUnifiedTopology":true}

LOG_LEVEL=info
LOG_FILE=logs/app.log

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

DUNNING_COOLDOWN_HOURS=24
OVERDUE_LEVEL1_DAYS=30
OVERDUE_LEVEL2_DAYS=90
OVERDUE_LEVEL3_DAYS=180

SMS_PLATFORM_URL=http://sms-platform.example.com/api/send
SMS_PLATFORM_API_KEY=your_sms_api_key

CHARGING_SYSTEM_URL=http://charging-system.example.com/api
CHARGING_SYSTEM_API_KEY=your_charging_api_key

EXPORT_PATH=exports
